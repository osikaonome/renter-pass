# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (EU region project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random bytes, e.g. `openssl rand -base64 32`. Signs requester sessions and hashes one-time codes.
APP_SECRET=

# Resend. Without a key, emails (and verification codes) are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM="RenterPass <hello@yourdomain.ie>"

# OpenRouter. Pick a reasoning model whose providers support zero data retention.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Web push: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@yourdomain.ie

# Upstash Redis (EU). Without it, rate limits are in-memory (development only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron sends this as a Bearer token
CRON_SECRET=
